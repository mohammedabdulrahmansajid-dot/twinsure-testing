@'
# Java, Maven, and Gradle output
**/target/
**/build/
*.class
*.jar
*.war
*.ear
*.log

# Angular and Node output
**/node_modules/
**/dist/
**/.angular/
**/.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Frontend test reports
**/coverage/
**/test-results/
**/playwright-report/
**/blob-report/

# Environment and secret files
.env
.env.*
!.env.example
**/application-local.properties
**/application-local.yml
**/application-local.yaml
**/application-secret.properties
**/application-secret.yml
**/application-secret.yaml
**/secrets/
*.pem
*.key
*.p12
*.jks

# IntelliJ IDEA
.idea/
**/.idea/
*.iml
*.iws
*.ipr
out/

# VS Code user settings
.vscode/
**/.vscode/

# Eclipse
.classpath
.project
.settings/
**/.settings/

# Operating-system files
.DS_Store
Thumbs.db
desktop.ini

# Temporary and backup files
*.tmp
*.temp
*.bak
*.swp
*~
'@ | Set-Content -Path ".gitignore" -Encoding utf8